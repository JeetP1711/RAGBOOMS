# ---------- Browser (public) ----------
# Safe to expose: Row Level Security protects the data.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
# Public site URL, used for canonical links and the sitemap (no trailing slash).
VITE_SITE_URL=https://ragbooms.com

# ---------- Server only (Vercel functions in /api) ----------
# NEVER prefix these with VITE_. They must not reach the browser.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SITE_URL=https://ragbooms.com

# GitHub: the username whose PUBLIC repositories are shown and importable.
GITHUB_USERNAME=JeetP1711
# Optional. Raises the API rate limit from 60 to 5000 requests/hour.
# A fine-grained token with "Public repositories (read-only)" access is enough.
GITHUB_TOKEN=

# Contact form
# Any random string; used to hash visitor IPs for rate limiting.
CONTACT_IP_SALT=change-me-to-a-long-random-string
# Optional email notification through Resend (https://resend.com).
RESEND_API_KEY=
CONTACT_NOTIFY_TO=
CONTACT_NOTIFY_FROM=RAGBOOMS <onboarding@resend.dev>
